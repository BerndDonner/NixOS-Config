# Copy this file to .sops.yaml after generating the host-specific age keys,
# replace both placeholders with the public recipients, and commit .sops.yaml.
keys:
  - &kitty AGE_RECIPIENT_KITTY
  - &tracy AGE_RECIPIENT_TRACY

creation_rules:
  - path_regex: ^secrets/.*\.sops\.env$
    age:
      - *kitty
      - *tracy
